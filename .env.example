DATABASE_URL=sqlite:///./soulrip.db
SQLITE_WAL=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_KEY=change-me

# OpenAI - 지역 정보 챗봇, AI Insight
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_MAX_CONCURRENCY=8
CHAT_CACHE_TTL_SECONDS=600
AI_INSIGHT_CACHE_TTL_SECONDS=600

# RAG - embedded(백엔드 안에서 rag-server/index 로드) / remote(별도 rag-server 호출) / off
RAG_MODE=embedded
RAG_SERVER_URL=
RAG_API_KEY=
RAG_TOP_K=4
RAG_MAX_CHARS_PER_HIT=700
RAG_TIMEOUT_SECONDS=5

META_CACHE_TTL_SECONDS=300

# RAG 평가(python -m scripts.chat_eval) 전용. 서비스 런타임에서는 사용하지 않는다.
LANGSMITH_API_KEY=
# workspace가 EU 리전이면 https://eu.api.smith.langchain.com 으로 바꾼다.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
